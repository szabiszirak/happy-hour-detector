rules_version = '2';
// Happy Hour Detector – Firebase Storage jogosultságok
// Megjegyzés: új projekteknél a Storage-hoz Blaze (használatalapú) csomag kell.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    function under5MB() { return request.resource.size < 5 * 1024 * 1024; }

    // Hitelesítő igazolások (fotó, blokk, cégkivonat): privát – csak a feltöltő és az admin olvashatja.
    // A döntés után 30 nappal törlendők (ütemezett Cloud Function, lásd README).
    match /claims/{uid}/{claimId}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && under5MB()
        && (isImage() || request.resource.contentType == 'application/pdf');
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Profilképek: a saját képét bárki csak magának töltheti fel (kicsinyítve, max. 1 MB); belépve látható.
    match /avatars/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && file == request.auth.uid + '.jpg'
        && request.resource.size < 1024 * 1024 && request.resource.contentType == 'image/jpeg';
      allow delete: if signedIn() && file == request.auth.uid + '.jpg';
    }

    // Helyfotók: nyilvánosak; feltölteni csak a hely ellenőrzött kocsmárosa tud.
    match /places/{placeId}/photos/{file} {
      function isPlaceOwner() {
        return signedIn()
          && firestore.exists(/databases/(default)/documents/owners/$(placeId))
          && firestore.get(/databases/(default)/documents/owners/$(placeId)).data.uid == request.auth.uid;
      }
      allow read: if true;
      allow create: if isPlaceOwner() && isImage() && under5MB();
      allow update: if false;
      allow delete: if isPlaceOwner() || isAdmin();
    }
  }
}
