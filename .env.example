# Másold át .env.local néven és töltsd ki.
# Ha a VITE_FIREBASE_API_KEY üres, az app DEMÓ módban fut (böngészőben tárolt adatok, demó belépés).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Térképcsempe-szerver (opcionális). Üresen a beépített vázlatos alaptérkép látszik.
# Példa (OpenStreetMap, kis forgalomra): https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=© OpenStreetMap közreműködők
