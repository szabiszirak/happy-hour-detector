# Másold át .env.local néven és töltsd ki.
# Ha a VITE_FIREBASE_API_KEY üres, az app DEMÓ módban fut (böngészőben tárolt adatok, demó belépés).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Alaptérkép: alapból a public/map/ mappa PMTiles fájljait használja (budapest.pmtiles, mvp.pmtiles),
# lásd scripts/download-map.sh. Más PMTiles fájl URL-je (opcionális):
VITE_PMTILES_URL=
# Raszteres csempeszerver tartaléknak (opcionális), ha nincs PMTiles fájl:
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=© OpenStreetMap közreműködők
